    {
      "id": "virgl",
      "component": "virglrenderer + Mesa virpipe",
      "pinned_version": "1.3.0",
      "license": "MIT",
      "upstream_url": "https://gitlab.freedesktop.org/virgl/virglrenderer",
      "supports_opengl": true,
      "supports_vulkan": false,
      "dxvk_eligible_when_operational": false,
