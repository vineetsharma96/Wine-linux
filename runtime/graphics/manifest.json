    },
    {
      "id": "software",
      "component": "Mesa LLVMpipe / Lavapipe",
      "pinned_version": "26.3.1",
      "license": "MIT",
      "upstream_url": "https://docs.mesa3d.org/",
      "supports_opengl": true,
      "supports_vulkan": false,
      "dxvk_eligible_when_operational": false,
      "vkd3d_requires_verified_extensions": false,
